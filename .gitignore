*.log
*.log.*

# Python cache
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
*.egg-info/
dist/
build/

# Node modules
node_modules/

# IDE and editor
.vscode/
.idea/
*.swp
*.swo
*~

