# Server Configuration
PORT=3000

# ComfyUI (roleplay bust portraits). Comfy must already be running.
COMFYUI_URL=http://127.0.0.1:8188
COMFYUI_TIMEOUT_MS=180000
# Batch generate page (10 images + upscale can take long)
COMFYUI_BATCH_TIMEOUT_MS=2700000
# ComfyUI output folder — used as fallback when history polling is slow
COMFYUI_OUTPUT_DIR=D:\AI\ComfyUI-master\ComfyUI\output
# Local Ollama + ComfyUI: min free VRAM (MB) before starting image generation (6GB default)
IMAGE_MIN_VRAM_MB=6144
VRAM_POLL_INTERVAL_MS=800
VRAM_WAIT_TIMEOUT_MS=120000
# Phase 5 only: do not enable until an img2img identity workflow exists.
# COMFYUI_VISION_I2I=1

# Volcengine (Ark) Configuration — Flutter 薄客户端不传 provider，聊天默认走这里
# 请在此处填入你的 API Key
VOLC_API_KEY='你的API_KEY'
# 聊天默认模型（与网页「Doubao → DeepSeek v4 Flash GA」一致）
VOLC_CHAT_MODEL=deepseek-v4-flash-ga-260731
# Doubao 1.8 Pro（别名 1.8）
VOLC_MODEL_1_8=doubao-seed-1-8-251228
# Doubao 1.6 Flash（支持视觉/多模态）
VOLC_MODEL_1_6=doubao-seed-1-6-flash-250828
# Doubao 2.0 Pro
VOLC_MODEL_2_0=doubao-seed-2-0-pro-260215
# Volcengine Base URL (OpenAI 兼容)
VOLC_BASE_URL=https://ark.cn-beijing.volces.com/api/v3

# DeepSeek 官网（仅当 DEFAULT_CHAT_PROVIDER=deepseek 时用）
DEEPSEEK_API_KEY='你的API_KEY'
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash-ga-260731
# 聊天默认供应商：doubao=火山方舟（含 DeepSeek v4）| deepseek=官网 | ollama
DEFAULT_CHAT_PROVIDER=doubao
